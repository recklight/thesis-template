% bib/references.bib -- demonstration bibliography.
%
% Seven entries covering the common types (book, article, misc), all of
% them real works that you can verify. They exist to show the required
% fields for each type and to give 'thesis-cli check-refs' something to
% audit; replace them with your own.
%
% What check-refs enforces here:
%   * every article entry has author, title, journal and year
%   * every book entry has author (or editor), title, publisher and year
%   * no name list ends with a stray comma (BibTeX only notes it in the .blg)
%   * the year field holds a year, not a whole citation
%   * no key is defined twice with different content
%
% Keys use the lastname+year+word convention. Any consistent scheme works;
% what matters is that a key never changes once it has been cited.

@BOOK{lamport1994latex,
  author    = {Leslie Lamport},
  title     = {{\LaTeX}: A Document Preparation System},
  edition   = {2nd},
  publisher = {Addison-Wesley},
  address   = {Reading, MA},
  year      = {1994},
  isbn      = {0-201-52983-1}
}

