# ---------------------------------------------------------------------------
# LaTeX build artefacts
# ---------------------------------------------------------------------------
# Everything a TeX run produces. Once these get committed they pile up,
# until another document's .aux and .bbl travel along with the thesis.
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.dvi
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.loa
*.lof
*.log
*.lot
*.nav
*.out
*.ps
*.run.xml
*.snm
*.spl
*.synctex.gz
*.toc
*.vrb
*.xdv
missfont.log
texput.log

# epstopdf writes these next to the .eps it converted; they are artefacts,
# not assets, and 'thesis-cli clean' removes them.
*-eps-converted-to.pdf

# Bounding-box files generated by ebb. Never commit them: their %%Title
# comment records the absolute path of the machine that produced them.
*.bb
*.xbb

# Build output directory used by 'thesis-cli build'.
build/

# Generated from thesis.toml on every build; committing it in a *thesis*
# invites someone to edit it by hand.
config/generated.tex

# The template is the exception: it ships a default generated.tex so that
# 'xelatex thesis.tex' works on a fresh copy, before thesis-cli has ever
# run. The same goes for the .gitignore that init copies into every new
# project.
!template/config/generated.tex
!template/.gitignore

# The compiled thesis goes to build/, which is ignored above. Uncommenting
# this ignores every other PDF as well, including figures saved as .pdf.
# *.pdf

# ---------------------------------------------------------------------------
# Editor and operating system leftovers
# ---------------------------------------------------------------------------
*.bak
*.asv
*~
*.swp
.vscode/
.idea/
Thumbs.db
ehthumbs.db
.DS_Store
Desktop.ini

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build-python/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------------------------------------------------------------------------
# Never commit research data
# ---------------------------------------------------------------------------
# Research data lives outside the repository. Nothing in this list
# belongs in version control, and none of it belongs in a template that
# other people will copy.
data/
raw/
*.mat
*.wav
*.dat
*.bin
*.npy
*.npz
*.xlsx
*.xls
